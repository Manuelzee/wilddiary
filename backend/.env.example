APP_ENV=production
# Required in production. Generate once, store in the deployment secret store,
# and share the same value across every worker and replica.
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_HOURS=24
# Set to your hosted frontend domain (or comma-separated domains, or * for open CORS)
CORS_ORIGINS=https://wilddiary.vercel.app,https://wilddiary.netlify.app,http://localhost:5173
HOST=0.0.0.0
PORT=5000
# Production: use a persistent PostgreSQL connection string from Neon, Supabase,
# Render, Railway, or another provider. Local development falls back to SQLite.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_PATH=./wilddiary.db

# Resend API for password reset OTP delivery
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Wild Diary <onboarding@resend.dev>

